# Copy to .env (gitignored). Every value has a default except the LLM credentials.

# Grafana datasource proxy: VPN-only. The token file holds only the token, outside any repo.
GRAFANA_URL=https://monitoring.starkfuture.com
GRAFANA_TOKEN_FILE=~/.config/golive/grafana-token
PROM_DATASOURCE_UID=prometheus
# Run `npm run dev -- doctor` to list the real uids, then set these.
LOKI_DATASOURCE_UID=
TEMPO_DATASOURCE_UID=

# Patrol
PATROL_WINDOW_MINUTES=15

# Model access for every agent. Leave both unset to run the patrol without the LLM.
# Option A, Anthropic API:   ANTHROPIC_API_KEY=...
# Option B, Bedrock EU:      CLAUDE_CODE_USE_BEDROCK=1, AWS_REGION=eu-west-1, AWS_PROFILE=...
# Per-agent model and limits live in agents/<name>/agent.yaml. This caps all agents together.
ENGINE_DAILY_CAP_USD=30
# Across all agents per UTC month. Also set a spend limit on the Anthropic workspace (Console) as the outer bound.
ENGINE_MONTHLY_CAP_USD=300

# Optional. Without it, cards are written to out/cards/ only.
SLACK_WEBHOOK_URL=

# Hosting. Runtime lessons and proposals (a persistent volume); unset = in agents/<name>/memory.
# ENGINE_MEMORY_DIR=/data/memory
# Engine code version recorded on every run (the image tag); unset = this checkout's git commit.
# ENGINE_BUILD=
# Browser origins allowed to call /mcp. MCP clients send no Origin; leave empty.
# ENGINE_ALLOWED_ORIGINS=
# In-cluster telemetry (hosted). With PROMETHEUS_URL set, the backends are queried directly
# and Grafana/GRAFANA_TOKEN_FILE are not used.
# PROMETHEUS_URL=http://kube-prometheus-stack-prometheus.monitoring:9090
# LOKI_URL=http://loki-gateway.monitoring:80
# LOKI_ORG_ID=1
# TEMPO_URL=http://tempo.monitoring:3100
# Agents this deployment offers (unset = all). Hosted: monitor,codebase here; research in a separate web deployment.
# ENGINE_AGENTS=monitor,codebase
# Google login that issues MCP tokens (hosted): all three, or none. People open <ENGINE_PUBLIC_URL>/login,
# sign in with their @ENGINE_LOGIN_DOMAIN Google account, and get a 90-day token. OAuth client in Stark's GCP project.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ENGINE_PUBLIC_URL=https://agent-engine.<internal domain>
# ENGINE_LOGIN_DOMAIN=starkfuture.com
# Hosted repos for the codebase agent (github: entries in the repos file), fetched as a GitHub App (contents: read).
# ENGINE_REPOS_DIR=/data/repos
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=/secrets/github-app.pem
