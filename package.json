{
  "name": "sre-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI SRE patrol: not-200 summary over prod telemetry, LLM investigator on what is new, Slack cards.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sre-agent": "dist/cli.js"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "smoke:llm": "node --disable-warning=ExperimentalWarning --import tsx scripts/smoke-investigator.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
